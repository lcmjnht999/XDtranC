{
    "name": "xdtranc",
    "version": "0.1.0",
    "description": "C++ 到仓颉草稿的本地迁移工作台（MVP）",
    "author": "XDtranC",
    "private": true,
    "type": "module",
    "packageManager": "pnpm@10.30.3",
    "engines": {
        "node": ">=22"
    },
    "scripts": {
        "typecheck": "tsc --noEmit && tsc --noEmit -p packages/renderer/tsconfig.json",
        "lint": "eslint packages",
        "test": "vitest run --no-file-parallelism --testTimeout=30000",
        "parse": "tsx packages/cli/src/index.ts",
        "chunk": "tsx packages/cli/src/chunk.ts",
        "convert": "tsx packages/cli/src/convert.ts",
        "export": "tsx packages/cli/src/export.ts",
        "dev": "node packages/main/build.mjs && electron packages/main/dist/main.mjs",
        "build": "node packages/main/build.mjs",
        "e2e": "node packages/main/build.mjs && playwright test",
        "pkg": "electron-builder --dir",
        "eval": "tsx packages/engine/eval.ts"
    },
    "devDependencies": {
        "@playwright/test": "1.57.0",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@types/node": "24.10.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/yauzl": "2.10.3",
        "@types/yazl": "2.4.5",
        "@vitejs/plugin-react": "^6.2.1",
        "electron": "39.2.7",
        "electron-builder": "^26.18.0",
        "esbuild": "0.25.12",
        "eslint": "9.39.1",
        "jsdom": "^30.1.3",
        "tsx": "4.20.6",
        "typescript": "5.9.3",
        "typescript-eslint": "8.48.0",
        "vite": "^8.3.5",
        "vitest": "3.2.4"
    },
    "dependencies": {
        "monaco-editor": "^0.57.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tree-sitter-wasms": "0.1.13",
        "web-tree-sitter": "0.20.8",
        "yauzl": "3.2.0",
        "yazl": "3.3.1"
    }
}